{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "C.le.VideoSR",
  "version": "0.1.0",
  "identifier": "com.cle.videosr",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "C.le.VideoSR",
        "width": 1240,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../runtime/**/*": "runtime/"
    }
  }
}
