{
  "schema_version": 1,
  "runtime_id": "c-le-videosr-runtime",
  "layout": {
    "binary_dir": "runtime/bin",
    "model_dir": "runtime/models"
  },
  "environment_overrides": {
    "runtime_dir": "CLE_VIDEOSR_RUNTIME_DIR",
    "model_dir": "CLE_VIDEOSR_MODEL_DIR"
  },
  "binaries": [
    {
      "id": "ffmpeg",
      "required_for": ["media_pipeline", "video_super_resolution"],
      "required": true,
      "license_review": "required_before_distribution"
    },
    {
      "id": "ffprobe",
      "required_for": ["media_probe", "video_super_resolution"],
      "required": true,
      "license_review": "required_before_distribution"
    },
    {
      "id": "realesrgan-ncnn-vulkan",
      "required_for": ["fast_super_resolution"],
      "required": true,
      "license_review": "required_before_distribution"
    },
    {
      "id": "realcugan-ncnn-vulkan",
      "required_for": ["fast_super_resolution_animation"],
      "required": false,
      "license_review": "required_before_distribution"
    },
    {
      "id": "rife-ncnn-vulkan",
      "required_for": ["frame_interpolation"],
      "required": false,
      "license_review": "required_before_distribution"
    }
  ],
  "notes": [
    "Large runtime binaries and model payloads are intentionally not committed to Git.",
    "The application prepends a staged runtime/bin directory to its child-process PATH.",
    "Development builds may fall back to binaries already available on the system PATH.",
    "Release packaging must verify each third-party runtime and model license before redistribution."
  ]
}
